{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useTemplate": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!plugins/sidecut-solo/server/data/workflows",
      "!**/*.md",
      "!plugins/sidecut-solo/server/index.mjs",
      "!plugins/sidecut-solo/server/usage.html",
      "!**/server/data/helper/solo.mjs",
      "!package-lock.json"
    ]
  }
}
