{
  "skill-log": {
    "PostToolUse": [
      {
        "matcher": "read_file|view_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-tool-use-skill-log.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "merge-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-use-merge-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "turn-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-turn-guard.mjs",
        "timeout": 5
      }
    ]
  }
}
