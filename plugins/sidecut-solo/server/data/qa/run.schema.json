{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA run contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_version",
    "kind",
    "subject",
    "environment",
    "invocation",
    "started_at",
    "finished_at",
    "status",
    "checks",
    "findings",
    "interventions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scenario_version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": ["dogfood", "regression", "session"]
    },
    "skills": {
      "description": "Each skill that ran, in order; a skill that ran twice appears twice. A session record lists at least one skill or one tool.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "invocation", "helped", "skipped"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-:][a-z0-9]+)*$"
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "invocation": {
            "enum": ["explicit", "automatic", "unknown"]
          },
          "helped": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "tools": {
      "description": "Optional. Each of the plugin's helper commands, MCP tools or hooks that ran without one of its skills, such as `solo qa-check` run by hand.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "helped", "skipped"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-:][a-z0-9]+)*$",
            "description": "<plugin>:<helper command, MCP tool or hook>, such as sidecut-solo:qa-check"
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "helped": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "comparison": {
      "description": "Optional. One arm of a with/without-plugin attribution pair; omit for ordinary runs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["arm", "pair_id", "runs", "score"],
      "properties": {
        "arm": {
          "enum": ["with-plugin", "without-plugin"]
        },
        "pair_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "revision", "dirty", "fingerprint"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "host_version", "requested_model", "resolved_model"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "host_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "invocation": {
      "enum": ["explicit", "automatic", "unknown", "mixed"]
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": ["pass", "fail", "blocked", "not_run"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "observed", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "enum": ["pass", "fail", "blocked", "not_run"]
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["pass", "fail"]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "severity", "summary", "check_id", "evidence", "reproduce"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": ["defect", "friction", "observation"]
          },
          "severity": {
            "enum": ["blocking", "major", "minor", "info"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "check_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "reproduce": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "defect"
                }
              }
            },
            "then": {
              "properties": {
                "reproduce": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1
                },
                "check_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            }
          }
        ]
      }
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "anyOf": [
              {
                "required": ["skills"],
                "properties": {
                  "skills": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              },
              {
                "required": ["tools"],
                "properties": {
                  "tools": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            ]
          },
          {
            "not": {
              "required": ["comparison"]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              }
            }
          },
          "findings": {
            "not": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "defect"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "status": {
                  "const": "fail"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "status": {
                  "const": "blocked"
                }
              }
            },
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "enum": ["fail"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_run"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              }
            },
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "enum": ["fail", "blocked"]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
